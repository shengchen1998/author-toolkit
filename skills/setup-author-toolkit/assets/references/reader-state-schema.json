{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reader-state-schema.json",
  "title": "author-toolkit independent resumable reader state",
  "type": "object",
  "required": [
    "schema_version",
    "state_id",
    "job_id",
    "scope_id",
    "perspective",
    "status",
    "next_sequence",
    "chunks",
    "summary",
    "open_questions",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "state_id": { "$ref": "#/$defs/id" },
    "job_id": { "$ref": "#/$defs/id" },
    "scope_id": { "$ref": "#/$defs/id" },
    "perspective": { "enum": ["intent", "standards", "fresh"] },
    "status": { "enum": ["in_progress", "interrupted", "complete"] },
    "next_sequence": { "type": "integer", "minimum": 1 },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "sequence", "sources", "report"],
        "additionalProperties": false,
        "properties": {
          "chunk_id": { "$ref": "#/$defs/id" },
          "sequence": { "type": "integer", "minimum": 1 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/sourceRange" }
          },
          "report": { "$ref": "relative-path-schema.json" }
        }
      }
    },
    "summary": { "type": "string" },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sourceRange": {
      "type": "object",
      "required": ["path", "sha256", "line_start", "line_end"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

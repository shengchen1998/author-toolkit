{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coverage-index-schema.json",
  "title": "author-toolkit living operation coverage index",
  "type": "object",
  "required": ["schema_version", "scope_id", "scope_fingerprint", "requested_pass", "entries", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "scope_id": { "$ref": "#/$defs/id" },
    "scope_fingerprint": { "$ref": "#/$defs/sha256" },
    "requested_pass": { "$ref": "#/$defs/passReference" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operation", "units", "synthesis_report", "synthesis_coverage"],
        "additionalProperties": false,
        "properties": {
          "operation": { "type": "string", "minLength": 1 },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["unit_id", "path", "sha256"],
              "additionalProperties": false,
              "properties": {
                "unit_id": { "$ref": "#/$defs/id" },
                "path": { "$ref": "relative-path-schema.json" },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          },
          "synthesis_report": {
            "anyOf": [{ "$ref": "relative-path-schema.json" }, { "type": "null" }]
          },
          "synthesis_report_sha256": { "$ref": "#/$defs/sha256" },
          "synthesis_coverage": {
            "anyOf": [{ "enum": ["full", "partial", "skipped"] }, { "type": "null" }]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "synthesis_report": { "type": "string" } }
            },
            "then": {
              "required": ["synthesis_report_sha256"],
              "properties": {
                "synthesis_report_sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          }
        ]
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "passReference": {
      "type": "object",
      "required": ["pass_id", "pass_fingerprint", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "pass_id": { "$ref": "#/$defs/id" },
        "pass_fingerprint": { "$ref": "#/$defs/sha256" },
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

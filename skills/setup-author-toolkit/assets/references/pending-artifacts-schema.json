{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pending-artifacts-schema.json",
  "title": "Pending artifact index",
  "type": "object",
  "required": ["schema_version", "operation", "artifacts", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "operation": {
      "$ref": "project-schema-v3.1.json#/properties/pending_action/properties/operation"
    },
    "scope_id": { "$ref": "project-schema-v3.1.json#/$defs/scope_id" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "relative-path-schema.json" }
    },
    "updated_at": { "$ref": "project-schema-v3.1.json#/$defs/timestamp" }
  }
}

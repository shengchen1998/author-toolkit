{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requested-pass-schema.json",
  "title": "author-toolkit requested revision pass v1",
  "type": "object",
  "required": [
    "schema_version",
    "pass_id",
    "pass_fingerprint",
    "target_scope",
    "required_operations",
    "paths",
    "language",
    "dependencies",
    "inapplicability",
    "narrowing",
    "baseline_pass",
    "requested_subchecks",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "pass_id": { "$ref": "#/$defs/id" },
    "pass_fingerprint": { "$ref": "#/$defs/sha256" },
    "target_scope": { "$ref": "#/$defs/scopeReference" },
    "required_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["operation", "paths", "subchecks"],
        "additionalProperties": false,
        "properties": {
          "operation": { "$ref": "#/$defs/operation" },
          "paths": { "$ref": "#/$defs/paths" },
          "subchecks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "paths": { "$ref": "#/$defs/paths" },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "inapplicability": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["operation", "subcheck", "paths", "reason"],
        "additionalProperties": false,
        "properties": {
          "operation": { "$ref": "#/$defs/operation" },
          "subcheck": { "type": "string", "minLength": 1 },
          "paths": { "$ref": "#/$defs/paths" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "narrowing": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["author_decision_id", "reason", "gaps"],
          "additionalProperties": false,
          "properties": {
            "author_decision_id": { "$ref": "#/$defs/id" },
            "reason": { "type": "string", "minLength": 1 },
            "gaps": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "baseline_pass": {
      "anyOf": [{ "$ref": "#/$defs/passReference" }, { "type": "null" }]
    },
    "requested_subchecks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["operation", "subcheck", "author_decision_id"],
        "additionalProperties": false,
        "properties": {
          "operation": { "$ref": "#/$defs/operation" },
          "subcheck": { "type": "string", "minLength": 1 },
          "author_decision_id": { "$ref": "#/$defs/id" }
        }
      }
    },
    "created_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "operation": {
      "enum": [
        "intake",
        "story-bible",
        "draft-baseline",
        "structure",
        "characters",
        "diagnostics",
        "revision-plan",
        "chapter-revision",
        "prose",
        "ai-cleanup",
        "current-scope-review",
        "final-review"
      ]
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "relative-path-schema.json" }
    },
    "dependency": {
      "type": "object",
      "required": ["path", "sha256", "role", "source"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "role": { "enum": ["story-bible", "draft-baseline", "revision-plan", "other"] },
        "source": {
          "anyOf": [{ "$ref": "#/$defs/dependencySource" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "enum": ["draft-baseline", "revision-plan"] } }
          },
          "then": {
            "properties": { "source": { "$ref": "#/$defs/dependencySource" } }
          }
        },
        {
          "if": {
            "properties": { "role": { "enum": ["story-bible", "other"] } }
          },
          "then": {
            "properties": { "source": { "type": "null" } }
          }
        }
      ]
    },
    "dependencySource": {
      "type": "object",
      "required": ["report_id", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "report_id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scopeReference": {
      "type": "object",
      "required": ["scope_id", "scope_fingerprint", "snapshot_path", "snapshot_sha256"],
      "additionalProperties": false,
      "properties": {
        "scope_id": { "$ref": "#/$defs/id" },
        "scope_fingerprint": { "$ref": "#/$defs/sha256" },
        "snapshot_path": { "$ref": "relative-path-schema.json" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "passReference": {
      "type": "object",
      "required": ["pass_id", "pass_fingerprint", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "pass_id": { "$ref": "#/$defs/id" },
        "pass_fingerprint": { "$ref": "#/$defs/sha256" },
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

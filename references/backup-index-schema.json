{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backup-index-schema.json",
  "title": "author-toolkit living backup index v1",
  "type": "object",
  "required": ["schema_version", "backups", "restorations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "backups": {
      "type": "array",
      "items": { "$ref": "#/$defs/backupEntry" }
    },
    "restorations": {
      "type": "array",
      "items": { "$ref": "#/$defs/restoration" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "approvalId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "backupEntry": {
      "type": "object",
      "required": [
        "backup_id",
        "operation",
        "approval_id",
        "scope_id",
        "scope_fingerprint",
        "manifest",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "backup_id": { "$ref": "#/$defs/id" },
        "operation": { "enum": ["chapter-revision", "creation-commit"] },
        "approval_id": { "$ref": "#/$defs/approvalId" },
        "scope_id": {
          "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "scope_fingerprint": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "manifest": { "$ref": "#/$defs/artifact" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "backupSource": {
      "type": "object",
      "required": ["type", "backup_id", "manifest"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "backup" },
        "backup_id": { "$ref": "#/$defs/id" },
        "manifest": { "$ref": "#/$defs/artifact" }
      }
    },
    "commitSource": {
      "type": "object",
      "required": ["type", "commit_id", "manifest"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "commit" },
        "commit_id": { "$ref": "#/$defs/id" },
        "manifest": { "$ref": "#/$defs/artifact" }
      }
    },
    "restoration": {
      "type": "object",
      "required": [
        "restoration_id",
        "source",
        "operation",
        "approval_id",
        "scope_id",
        "scope_fingerprint",
        "safety_backup_id",
        "files",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "restoration_id": { "$ref": "#/$defs/id" },
        "source": {
          "oneOf": [
            { "$ref": "#/$defs/backupSource" },
            { "$ref": "#/$defs/commitSource" }
          ]
        },
        "operation": { "enum": ["chapter-revision", "creation-commit"] },
        "approval_id": { "$ref": "#/$defs/approvalId" },
        "scope_id": {
          "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "scope_fingerprint": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "safety_backup_id": { "$ref": "#/$defs/id" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "backup-manifest-schema.json#/$defs/file" }
        },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

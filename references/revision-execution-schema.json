{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "revision-execution-schema.json",
  "title": "author-toolkit revision execution record v1",
  "type": "object",
  "required": [
    "schema_version",
    "execution_id",
    "cycle_id",
    "plan",
    "batch",
    "requested_pass",
    "input_scope",
    "target_scope",
    "finding_dispositions",
    "author_decision_ids",
    "approval_ids",
    "backups",
    "files",
    "status",
    "created_at",
    "verified_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "execution_id": { "$ref": "#/$defs/id" },
    "cycle_id": { "$ref": "#/$defs/id" },
    "plan": { "$ref": "#/$defs/planReference" },
    "batch": { "$ref": "#/$defs/batchReference" },
    "requested_pass": { "$ref": "#/$defs/passReference" },
    "input_scope": { "$ref": "#/$defs/scopeReference" },
    "target_scope": { "$ref": "#/$defs/scopeReference" },
    "finding_dispositions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["finding_id", "disposition", "author_decision_id"],
        "additionalProperties": false,
        "properties": {
          "finding_id": { "$ref": "#/$defs/findingId" },
          "disposition": { "enum": ["execute", "defer", "dismiss"] },
          "author_decision_id": { "$ref": "#/$defs/decisionId" }
        }
      }
    },
    "author_decision_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/decisionId" }
    },
    "approval_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/decisionId" }
    },
    "backups": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["backup_id", "approval_id", "manifest", "files"],
        "additionalProperties": false,
        "properties": {
          "backup_id": { "$ref": "#/$defs/id" },
          "approval_id": { "$ref": "#/$defs/decisionId" },
          "manifest": { "$ref": "#/$defs/artifactReference" },
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["path", "backup_path", "sha256"],
              "additionalProperties": false,
              "properties": {
                "path": { "$ref": "relative-path-schema.json" },
                "backup_path": { "$ref": "relative-path-schema.json" },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "action", "input_sha256", "output_sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "relative-path-schema.json" },
          "action": { "enum": ["create", "modify", "delete", "reorder"] },
          "input_sha256": {
            "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
          },
          "output_sha256": {
            "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
          }
        }
      }
    },
    "status": { "enum": ["prepared", "verified"] },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "verified_at": {
      "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "prepared" } }
      },
      "then": {
        "properties": { "verified_at": { "type": "null" } }
      },
      "else": {
        "properties": { "verified_at": { "$ref": "#/$defs/timestamp" } }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "findingId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "artifactReference": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "planReference": {
      "type": "object",
      "required": ["plan_id", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "plan_id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "batchReference": {
      "type": "object",
      "required": ["batch_id", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "batch_id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "passReference": {
      "type": "object",
      "required": ["pass_id", "pass_fingerprint", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "pass_id": { "$ref": "#/$defs/id" },
        "pass_fingerprint": { "$ref": "#/$defs/sha256" },
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scopeReference": {
      "type": "object",
      "required": ["scope_id", "scope_fingerprint", "snapshot_path", "snapshot_sha256"],
      "additionalProperties": false,
      "properties": {
        "scope_id": { "$ref": "#/$defs/id" },
        "scope_fingerprint": { "$ref": "#/$defs/sha256" },
        "snapshot_path": { "$ref": "relative-path-schema.json" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creation-batch-schema.json",
  "title": "author-toolkit creation batch",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "operation",
    "source_mode",
    "status",
    "scope_id",
    "plan",
    "files",
    "story_state",
    "approvals",
    "commit",
    "next_action",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "batch_id": { "$ref": "#/$defs/id" },
    "operation": {
      "enum": [
        "creation-baseline",
        "writing-plan",
        "chapter-creation",
        "chapter-review",
        "creation-commit",
        "creation-import",
        "milestone-review"
      ]
    },
    "source_mode": { "enum": ["ai", "author", "mixed"] },
    "status": {
      "enum": [
        "proposed",
        "in_progress",
        "awaiting_author",
        "accepted",
        "committed",
        "rejected",
        "blocked",
        "restored"
      ]
    },
    "scope_id": {
      "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
    },
    "plan": {
      "type": "object",
      "required": ["summary", "context", "dependency_fingerprint"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "version", "version_type"],
            "additionalProperties": false,
            "properties": {
              "path": { "$ref": "relative-path-schema.json" },
              "version": { "type": "string", "minLength": 1 },
              "version_type": { "enum": ["sha256", "git", "author", "untracked"] }
            }
          }
        },
        "dependency_fingerprint": { "$ref": "#/$defs/hash" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "action", "input_sha256", "output_sha256", "status"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "relative-path-schema.json" },
          "action": { "enum": ["create", "modify", "delete", "reorder"] },
          "input_sha256": { "$ref": "#/$defs/nullableHash" },
          "output_sha256": { "$ref": "#/$defs/nullableHash" },
          "status": {
            "enum": ["pending", "staged", "accepted", "written", "verified", "restored"]
          }
        }
      }
    },
    "story_state": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "relative-path-schema.json" },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "approvals": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$" }
    },
    "commit": {
      "anyOf": [{ "$ref": "relative-path-schema.json" }, { "type": "null" }]
    },
    "next_action": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableHash": {
      "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
    }
  }
}

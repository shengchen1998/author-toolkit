{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "no-edit-skip-schema.json",
  "title": "author-toolkit no-edit revision skip v1",
  "type": "object",
  "required": [
    "schema_version",
    "skip_id",
    "requested_pass",
    "scope_fingerprint",
    "operations",
    "covered_findings",
    "author_decision_id",
    "reason",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "skip_id": { "$ref": "#/$defs/id" },
    "requested_pass": { "$ref": "#/$defs/passReference" },
    "scope_fingerprint": { "$ref": "#/$defs/sha256" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["revision-plan", "chapter-revision"] }
    },
    "covered_findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
      }
    },
    "author_decision_id": { "$ref": "#/$defs/id" },
    "reason": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "passReference": {
      "type": "object",
      "required": ["pass_id", "pass_fingerprint", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "pass_id": { "$ref": "#/$defs/id" },
        "pass_fingerprint": { "$ref": "#/$defs/sha256" },
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

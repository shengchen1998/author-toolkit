{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-job-schema.json",
  "title": "author-toolkit resumable layered review job",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "mode",
    "perspective",
    "scope_id",
    "status",
    "coverage",
    "files",
    "chunks",
    "volumes",
    "book",
    "context_budget",
    "next_chunk_id",
    "reviewer_state_path",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "job_id": { "$ref": "#/$defs/id" },
    "mode": { "enum": ["final", "current-scope", "request"] },
    "perspective": { "enum": ["intent", "standards", "fresh"] },
    "scope_id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["prepared", "in_progress", "interrupted", "complete"] },
    "coverage": { "enum": ["partial", "full"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "line_count"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "relative-path-schema.json" },
          "sha256": { "$ref": "#/$defs/hash" },
          "line_count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chunk_id", "sequence", "status", "sources", "report"],
        "additionalProperties": false,
        "properties": {
          "chunk_id": { "$ref": "#/$defs/id" },
          "sequence": { "type": "integer", "minimum": 1 },
          "status": { "$ref": "#/$defs/status" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/sourceRange" }
          },
          "report": { "$ref": "#/$defs/nullableReport" }
        }
      }
    },
    "volumes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["volume_id", "chunk_ids", "status", "report"],
        "additionalProperties": false,
        "properties": {
          "volume_id": { "$ref": "#/$defs/id" },
          "chunk_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "status": { "$ref": "#/$defs/status" },
          "report": { "$ref": "#/$defs/nullableReport" }
        }
      }
    },
    "book": {
      "type": "object",
      "required": ["volume_ids", "status", "report"],
      "additionalProperties": false,
      "properties": {
        "volume_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "status": { "$ref": "#/$defs/status" },
        "report": { "$ref": "#/$defs/nullableReport" }
      }
    },
    "context_budget": {
      "type": "object",
      "required": ["profile", "estimate_tokens"],
      "additionalProperties": false,
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "estimate_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "next_chunk_id": {
      "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
    },
    "reviewer_state_path": { "$ref": "relative-path-schema.json" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["pending", "in_progress", "interrupted", "complete"] },
    "nullableReport": {
      "anyOf": [{ "$ref": "relative-path-schema.json" }, { "type": "null" }]
    },
    "sourceRange": {
      "type": "object",
      "required": ["path", "sha256", "line_start", "line_end"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "$ref": "#/$defs/hash" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

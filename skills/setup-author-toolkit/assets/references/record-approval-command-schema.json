{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "record-approval-command-schema.json",
  "title": "author-toolkit record-approval command v1",
  "type": "object",
  "required": ["approval_id", "type", "operation", "scope_id", "paths", "files", "status", "reason"],
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
    },
    "type": { "type": "string", "minLength": 1 },
    "operation": {
      "enum": [
        "intake",
        "story-bible",
        "draft-baseline",
        "structure",
        "diagnostics",
        "characters",
        "revision-plan",
        "chapter-revision",
        "prose",
        "ai-cleanup",
        "current-scope-review",
        "final-review",
        "creation-baseline",
        "writing-plan",
        "chapter-creation",
        "chapter-review",
        "creation-commit",
        "creation-import",
        "milestone-review"
      ]
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "relative-path-schema.json" }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    },
    "status": { "enum": ["approved", "deferred", "cancelled", "superseded"] },
    "reason": { "type": "string", "minLength": 1 },
    "revision": { "$ref": "#/$defs/revision" },
    "expected_tracker_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableSha256": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "file": {
      "type": "object",
      "required": ["path", "action", "input_sha256", "output_sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "relative-path-schema.json" },
        "action": { "type": "string", "minLength": 1 },
        "input_sha256": { "$ref": "#/$defs/nullableSha256" },
        "output_sha256": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "plan": {
      "type": "object",
      "required": ["plan_id", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "plan_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "batch": {
      "type": "object",
      "required": ["batch_id", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "batch_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "revision": {
      "type": "object",
      "required": ["plan", "batch", "scope_fingerprint"],
      "additionalProperties": false,
      "properties": {
        "plan": { "$ref": "#/$defs/plan" },
        "batch": { "$ref": "#/$defs/batch" },
        "scope_fingerprint": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-schema-v2.json",
  "title": "author-toolkit report envelope v2",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "audit",
    "stage",
    "created_at",
    "language",
    "skill",
    "inputs",
    "engine",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "report_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "audit": { "type": "string", "minLength": 1 },
    "stage": {
      "enum": [
        "intake",
        "story-bible",
        "structure",
        "characters",
        "revision-plan",
        "chapter-revision",
        "prose",
        "ai-cleanup",
        "final-review",
        "draft-baseline",
        "diagnostics",
        "current-scope-review"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "skill": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "version", "version_type"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "relative-path-schema.json" },
          "version": { "type": "string", "minLength": 1 },
          "version_type": { "enum": ["sha256", "git", "author", "untracked"] }
        }
      }
    },
    "engine": {
      "type": "object",
      "required": ["name", "version", "degraded", "notes"],
      "additionalProperties": false,
      "properties": {
        "name": { "enum": ["conversational", "scriptorium"] },
        "version": { "type": "string", "minLength": 1 },
        "degraded": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "finding-schema-v2.json" }
    }
  }
}

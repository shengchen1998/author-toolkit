{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coverage-unit-schema.json",
  "title": "author-toolkit reusable local coverage unit",
  "type": "object",
  "required": [
    "schema_version",
    "unit_id",
    "source_report",
    "scope_id",
    "operation",
    "kind",
    "paths",
    "subchecks",
    "dependencies",
    "coverage",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "unit_id": { "$ref": "#/$defs/id" },
    "source_report": { "$ref": "relative-path-schema.json" },
    "source_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_id": { "$ref": "#/$defs/id" },
    "operation": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["local", "synthesis"] },
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/versionedPath" }
    },
    "subchecks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/versionedPath" }
    },
    "coverage": { "enum": ["full", "partial", "skipped"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "versionedPath": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}

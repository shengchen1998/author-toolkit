{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding-schema-v2.json",
  "title": "author-toolkit finding v2",
  "type": "object",
  "required": [
    "id",
    "audit",
    "technique",
    "severity",
    "location",
    "issue",
    "recommendation",
    "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$",
      "description": "Stable finding identifier with three or more digits, for example STRUCT-001 or STRUCT-1000."
    },
    "audit": { "type": "string", "minLength": 1 },
    "technique": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["note", "suggestion", "warning"] },
    "location": {
      "type": "object",
      "required": ["file", "scope"],
      "additionalProperties": false,
      "dependentRequired": {
        "end_line": ["line"]
      },
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["file", "chapter", "line", "passage"] },
        "chapter": { "type": "integer", "minimum": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "scope": { "const": "file" } } },
          "then": {
            "properties": {
              "chapter": false,
              "line": false,
              "end_line": false,
              "quote": false
            }
          }
        },
        {
          "if": { "properties": { "scope": { "const": "chapter" } } },
          "then": {
            "required": ["chapter"],
            "properties": {
              "line": false,
              "end_line": false
            }
          }
        },
        {
          "if": { "properties": { "scope": { "const": "line" } } },
          "then": {
            "required": ["line"],
            "properties": { "end_line": false }
          }
        },
        {
          "if": { "properties": { "scope": { "const": "passage" } } },
          "then": { "required": ["quote"] }
        }
      ]
    },
    "issue": { "type": "string", "minLength": 1 },
    "recommendation": { "type": "string", "minLength": 1 },
    "confidence": { "enum": ["deterministic", "judgment"] },
    "exemplar": { "type": "string", "minLength": 1 }
  }
}

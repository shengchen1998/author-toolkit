{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backup-manifest-schema.json",
  "title": "author-toolkit backup manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "backup_id",
    "operation",
    "approval_id",
    "scope_id",
    "scope_fingerprint",
    "files",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "backup_id": { "$ref": "#/$defs/id" },
    "operation": { "enum": ["chapter-revision", "creation-commit"] },
    "approval_id": { "$ref": "#/$defs/approvalId" },
    "scope_id": {
      "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
    },
    "scope_fingerprint": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "approvalId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableSha256": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "file": {
      "type": "object",
      "required": ["path", "action", "input_sha256", "output_sha256", "backup_path"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "relative-path-schema.json" },
        "action": { "enum": ["create", "modify", "delete", "reorder"] },
        "input_sha256": { "$ref": "#/$defs/nullableSha256" },
        "output_sha256": { "$ref": "#/$defs/nullableSha256" },
        "backup_path": {
          "anyOf": [{ "$ref": "relative-path-schema.json" }, { "type": "null" }]
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "record-restore-command-schema.json",
  "title": "author-toolkit record-restore command v1",
  "type": "object",
  "required": [
    "restoration_id",
    "safety_backup_id",
    "operation",
    "approval_id",
    "scope_id",
    "scope_fingerprint",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "restoration_id": { "$ref": "#/$defs/id" },
    "source_backup_id": { "$ref": "#/$defs/id" },
    "source_commit": {
      "type": "object",
      "required": ["commit_id", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "commit_id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "relative-path-schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "safety_backup_id": { "$ref": "#/$defs/id" },
    "operation": { "enum": ["chapter-revision", "creation-commit"] },
    "approval_id": { "$ref": "#/$defs/approvalId" },
    "scope_id": {
      "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
    },
    "scope_fingerprint": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    },
    "expected_index_sha256": { "$ref": "#/$defs/sha256" }
  },
  "oneOf": [
    {
      "properties": { "source_backup_id": true },
      "required": ["source_backup_id"]
    },
    {
      "properties": { "source_commit": true },
      "required": ["source_commit"]
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "approvalId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableSha256": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "file": {
      "type": "object",
      "required": ["path", "action", "input_sha256", "output_sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "relative-path-schema.json" },
        "action": { "enum": ["create", "modify", "delete", "reorder"] },
        "input_sha256": { "$ref": "#/$defs/nullableSha256" },
        "output_sha256": { "$ref": "#/$defs/nullableSha256" }
      }
    }
  }
}

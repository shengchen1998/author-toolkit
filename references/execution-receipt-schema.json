{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-receipt-schema.json",
  "title": "author-toolkit post-write execution receipt",
  "type": "object",
  "required": [
    "schema_version",
    "approval_id",
    "operation",
    "scope_id",
    "backup_ids",
    "files",
    "recorded_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "approval_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
    },
    "operation": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "scope_id": { "type": "string", "minLength": 1 },
    "backup_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "action", "input_sha256", "output_sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "relative-path-schema.json" },
          "action": { "enum": ["create", "modify", "delete", "reorder"] },
          "input_sha256": { "$ref": "#/$defs/nullableHash" },
          "output_sha256": { "$ref": "#/$defs/nullableHash" }
        }
      }
    },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableHash": {
      "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
    }
  }
}
